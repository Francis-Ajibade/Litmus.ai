# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Secrets — API keys live here, never commit them
.env
.env.*
!.env.example

# OS
.DS_Store

# JS (frontend, later)
node_modules/


# Private — kept LOCAL, never published (docs, mockups, drafts, tooling)
# Every .md is private except the READMEs. Neither pattern has a slash, so both
# match at ANY depth — which is exactly what keeps web/README.md publishable
# while CLAUDE-4.md and PRD-4.md at the root stay hidden.
*.md
!README.md

#SLASH anchors this to the repo root, so web/index.html — Vite's entry point,
# without which the frontend cannot build — is never matched.
/*.html

# Local Claude Code config — settings and permissions, not project source.
.claude/

# Design mockups and canvas exports. Private working material, and
# litmus-surface-flow.html alone is 2.3MB — git keeps a blob forever once it
# lands, so these stay out of history rather than being cleaned up later.
design/
